#!/usr/bin/env Rscript

args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 1L || !nzchar(args[[1L]])) {
  stop("Usage: scripts/build-model-payload MODEL_DIR", call. = FALSE)
}

model_dir <- normalizePath(args[[1L]], winslash = "/", mustWork = TRUE)
if (!requireNamespace("mfclshiny", quietly = TRUE)) {
  stop("The pinned mfclshiny package is required to build model_payload.rds.", call. = FALSE)
}

payload_file <- file.path(model_dir, "model_payload.rds")
mfclshiny::build_model_payload(
  model_dir,
  output_file = payload_file,
  overwrite = TRUE,
  recursive = FALSE,
  object_cache = "all",
  artifacts = "all"
)

required <- c(
  payload_file,
  file.path(model_dir, "model_payload_manifest.json"),
  file.path(model_dir, "model_payload_manifest.csv")
)
missing <- required[!file.exists(required) | file.info(required)$size <= 0]
if (length(missing)) {
  stop("MFCL Shiny payload output is incomplete: ", paste(missing, collapse = ", "), call. = FALSE)
}

payload <- readRDS(payload_file)
restore_dir <- tempfile("mfclshiny-payload-restore-")
dir.create(restore_dir, recursive = TRUE, showWarnings = FALSE)
on.exit(unlink(restore_dir, recursive = TRUE, force = TRUE), add = TRUE)
restored <- mfclshiny::restore_model_payload_files(
  payload_file,
  output_dir = restore_dir,
  overwrite = TRUE
)
if (!is.data.frame(restored) || !nrow(restored)) {
  stop("The generated payload did not restore any model files.", call. = FALSE)
}

source_role_file <- function(role) {
  candidates <- switch(
    role,
    par = file.path(model_dir, "final.par"),
    length_fit = file.path(model_dir, "length.fit"),
    weight_fit = file.path(model_dir, "weight.fit"),
    temporary_tag_report = file.path(model_dir, "temporary_tag_report"),
    indepvar = file.path(model_dir, "indepvar.rpt"),
    tag = list.files(model_dir, pattern = "[.]tag$", full.names = TRUE),
    age_length = list.files(model_dir, pattern = "[.]age_length$", full.names = TRUE),
    character()
  )
  candidates <- candidates[file.exists(candidates)]
  if (length(candidates)) candidates[[1L]] else ""
}
required_roles <- c("par", "rep")
optional_roles <- c(
  "temporary_tag_report", "length_fit", "weight_fit", "tag",
  "age_length", "indepvar"
)
required_roles <- unique(c(
  required_roles,
  optional_roles[vapply(optional_roles, function(role) {
    nzchar(source_role_file(role))
  }, logical(1L))]
))
restored$source_file <- vapply(restored$role, source_role_file, character(1L))
restored$required <- restored$role %in% required_roles
restored$restored_md5 <- unname(tools::md5sum(restored$file))
restored$source_md5 <- vapply(restored$source_file, function(path) {
  if (nzchar(path) && file.exists(path)) unname(tools::md5sum(path)) else ""
}, character(1L))
restored$source_matches <- !nzchar(restored$source_md5) |
  restored$restored_md5 == restored$source_md5
missing_roles <- setdiff(required_roles, restored$role)
mismatched_roles <- restored$role[restored$required & !restored$source_matches]
if (length(missing_roles) || length(mismatched_roles)) {
  stop(
    "Payload restoration validation failed; missing roles: ",
    paste(missing_roles, collapse = ", "),
    "; checksum mismatches: ",
    paste(mismatched_roles, collapse = ", "),
    call. = FALSE
  )
}
write.csv(restored, file.path(model_dir, "payload-restore-audit.csv"), row.names = FALSE)
saveRDS(restored, file.path(model_dir, "payload-restore-audit.rds"), compress = "xz")
if (requireNamespace("jsonlite", quietly = TRUE)) {
  jsonlite::write_json(
    restored,
    file.path(model_dir, "payload-restore-audit.json"),
    dataframe = "rows",
    auto_unbox = TRUE,
    pretty = TRUE,
    null = "null"
  )
}
writeLines(
  c(
    "Portable MFCL model payload",
    "",
    "Open directly with MFCL Shiny by selecting this folder.",
    "Restore embedded model files with:",
    "Rscript -e 'mfclshiny::restore_model_payload_files(\"model_payload.rds\", output_dir=\"restored\", overwrite=TRUE)'"
  ),
  file.path(model_dir, "README.txt")
)

cat("MFCL Shiny payload ready:", payload_file, "\n")
