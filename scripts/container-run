#!/bin/bash
set -euo pipefail

mode=${1:?fit or final is required}
repo_root=${REPO_ROOT:?REPO_ROOT is required}
run_dir=${RUN_DIR:?RUN_DIR is required}
program_path=${PROGRAM_PATH:?PROGRAM_PATH is required}

cp -R "$repo_root/model/." "$run_dir/"
cd "$run_dir"
chmod +x doitall.sh

if [[ $mode == fit ]]; then
  MODEL_ID="${MODEL_ID:-Diagnostic}" PROGRAM_PATH="$program_path" ./doitall.sh 2>&1 | tee mfcl.log
  test -s 11.par
  cp 11.par final.par
  sha256sum final.par > final.par.sha256
  observed=$(sha256sum final.par | awk '{print $1}')
  expected=21dcaea9db8c89ddc8c29fa3c3a5e514b50bef6e26587c168c00c05f35fbebc3
  printf 'Reference final PAR: %s\nObserved final PAR:  %s\n' "$expected" "$observed"
  if [[ $observed == "$expected" ]]; then
    "$repo_root/restore-hessian" "$run_dir"
  else
    echo "Archived Hessian not restored because this fit differs from the reference final PAR."
  fi
elif [[ $mode == final ]]; then
  cp "$repo_root/results/reference/final.par" final.par
  set +e
  "$program_path" bet.frq final.par evaluated.par -file - 2>&1 <<'MFCL_SWITCHES' | tee mfcl-final.log
  1 1 0
  1 246 1
MFCL_SWITCHES
  status=${PIPESTATUS[0]}
  set -e
  if [[ $status -ne 0 && $status -ne 3 ]]; then
    echo "MFCL final-PAR evaluation failed with status $status." >&2
    exit "$status"
  fi
  test -s evaluated.par
  echo "Reference final.par evaluated successfully."
  "$repo_root/restore-hessian" "$run_dir"
else
  echo "Unknown run mode: $mode" >&2
  exit 2
fi

Rscript "$repo_root/scripts/build-model-payload" "$run_dir"
