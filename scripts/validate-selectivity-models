#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mfcl=$root/mfclo64
reference=$root/results/reference/final.par

test -x "$mfcl"
test -s "$reference"
test "$(find "$root/model/model-inputs" -maxdepth 1 -type f | wc -l)" -eq 1
test "$(find "$root/model/selectivity-models" -maxdepth 1 -type f | wc -l)" -eq 1
test -s "$root/model/model-inputs/Diagnostic.conf"
test -s "$root/model/selectivity-models/Diagnostic.csv"

ini_steepness=$(awk '
  /^# sv[(]29[)]/ { getline; print $1; found++; exit }
  END { if (found != 1) exit 1 }
' "$root/model/bet.ini")
test "$ini_steepness" = 0.90

if grep -Ev '^[[:space:]]*#' "$root/model/doitall.sh" | grep -Eiq 'seed.?23|checkpoint'; then
  echo "Diagnostic doitall contains a seed or checkpoint path." >&2
  exit 1
fi

(
  cd "$root/model"
  MODEL_ID=Diagnostic MODEL_AUDIT_PAR="$reference" \
    PROGRAM_PATH="$mfcl" ./doitall.sh
)

controls=$(
  cd "$root/model"
  MODEL_ID=Diagnostic SELECTIVITY_PRINT_CONTROLS=1 \
    PROGRAM_PATH="$mfcl" ./doitall.sh |
    awk '/^[[:space:]]+-[0-9]+[[:space:]]/ { print }'
)
printf '%s\n' "$controls" | awk '
  NF && $2 != 16 && $2 != 24 && $2 != 56 && $2 != 57 && $2 != 61 {
    print "Unexpected Diagnostic selectivity flag: " $0 > "/dev/stderr"
    exit 1
  }
'

printf '%s\n' "$controls" | awk '
  $1 == -10 && $2 == 16 && $3 == 1 { f10_16++ }
  $1 == -10 && $2 == 56 && $3 == 10000 { f10_56++ }
  $1 == -33 && $2 == 16 && $3 == 1 { f33_16++ }
  $1 == -33 && $2 == 56 && $3 == 10000 { f33_56++ }
  $2 == 24 && -$1 != $3 { bad_group++ }
  END {
    exit(f10_16 == 1 && f10_56 == 1 && f33_16 == 1 && f33_56 == 1 &&
         bad_group == 0 ? 0 : 1)
  }
'

echo "Diagnostic Job 21641 h=0.90, tau=2, M, DM and selectivity audits passed."
